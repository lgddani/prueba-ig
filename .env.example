# Copiar este archivo a ".env" antes de ejecutar `docker compose up --build`.
# Los valores ya están completos para que la solución levante sin pasos manuales;
# en un despliegue real, JWT_SECRET y PASSWORD_PEPPER deben reemplazarse por secretos
# propios (no reutilizar los valores de este ejemplo en producción).

# --- Base de datos ---
POSTGRES_DB=kanban
POSTGRES_USER=kanban_user
POSTGRES_PASSWORD=kanban_pass_dev
POSTGRES_PORT=5432

# --- API (.NET) ---
API_PORT=5080
JWT_SECRET=kanban-default-jwt-secret-DEV-ONLY-CHANGE-IN-PRODUCTION-0123456789
JWT_ISSUER=Kanban.Api
JWT_AUDIENCE=Kanban.Client
JWT_EXPIRATION_MINUTES=480
# Pepper de hashing de contraseñas: debe coincidir con el usado para generar los
# hashes de los usuarios semilla (ver migración SeedUsuarios) para que el login
# funcione con los valores por defecto.
PASSWORD_PEPPER=kanban-default-pepper-DEV-ONLY-CHANGE-IN-PRODUCTION
CORS_ALLOWED_ORIGIN=http://localhost:4200

# --- Frontend (Angular servido con nginx) ---
FRONTEND_PORT=4200
API_URL=http://localhost:5080/api
SIGNALR_URL=http://localhost:5080/hubs/board
